<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>whisper-server</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/whisper/whisper.cpp/build/bin/whisper-server</string>
    <string>-m</string><string>__HOME__/whisper/models/ggml-large-v3-turbo.bin</string>
    <string>--host</string><string>127.0.0.1</string>
    <string>--port</string><string>8080</string>
    <string>-l</string><string>en</string>
    <string>-t</string><string>4</string>
    <string>-ac</string><string>640</string>
    <string>--no-context</string>
    <string>--suppress-nst</string>
    <string>--vad</string>
    <string>--vad-model</string><string>__HOME__/whisper/models/ggml-silero-v5.1.2.bin</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityBackgroundIO</key><true/>
  <key>StandardOutPath</key><string>__HOME__/whisper/server.log</string>
  <key>StandardErrorPath</key><string>__HOME__/whisper/server.log</string>
</dict>
</plist>
